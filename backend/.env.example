# All variables below are validated at startup by backend/config.py
# (Sprint 1, IMPLEMENTATION_PLAN.md) — the app refuses to boot on a bad
# value rather than fail confusingly on the first request that needs it.

APP_ENV=development
APP_ID=canvas-grade

# Required: generate a unique value of at least 32 characters.
SECRET_KEY=

# SQLAlchemy URL. Percent-encode reserved characters in the password.
DATABASE_URL=postgresql+psycopg://campusgrade:CHANGE_ME@localhost:5433/campusgrade_db

# frontend-legacy (Vite) runs on 5174; the new Next.js frontend runs on 3000.
# Keep both while both frontends exist during the migration.
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000
PORT=5001
FASTAPI_RELOAD=false
# true once the app is served over HTTPS — controls the Secure flag on the
# refresh-token cookie. Leave false for local http:// development.
COOKIE_SECURE=false
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

GITHUB_TOKEN=
ASSIGNMENT_MAX_ARCHIVE_BYTES=104857600
ASSIGNMENT_MAX_FILES=10000
ASSIGNMENT_MAX_TEXT_BYTES=1048576
REPOSITORY_SYNC_INTERVAL_SECONDS=120

# Run once via `python bootstrap_admin.py` to create the first super admin.
# Not needed for normal app startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=CampusGrade Administrator

# Azure OpenAI assignment-drafting provider. DEPLOYMENT is the name you gave
# the model deployment in Azure AI Foundry; it is not the base model name.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-10-21
# Private assignment storage. Use s3 in production.
PRIVATE_STORAGE_BACKEND=local
PRIVATE_STORAGE_PATH=
PRIVATE_S3_BUCKET=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_REGION=

REVOKED_SESSION_RETENTION_DAYS=7
