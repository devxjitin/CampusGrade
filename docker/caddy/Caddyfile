{
	# No admin API listener in the container.
	admin off
}

{$SITE_ADDRESS:campusgrade.localhost} {
	tls {$CADDY_TLS:internal}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Safe subset of a CSP; the full script/style policy is tightened in Sprint 6.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		-Server
	}

	# /api/* -> FastAPI. The prefix is stripped, so the backend keeps its own
	# unprefixed routes (/login, /health, /ready, ...).
	handle_path /api/* {
		request_body {
			max_size 110MB
		}
		reverse_proxy {
			# Docker DNS returns every api replica; re-resolve so scaling and
			# restarts are picked up without reloading Caddy.
			dynamic a {
				name api
				port 5001
				refresh 5s
			}
			lb_policy round_robin
			# Ride out a replica restarting during a deploy.
			lb_try_duration 10s
			lb_try_interval 250ms
			health_uri /ready
			health_interval 10s
			health_timeout 5s
		}
	}

	# Presigned object-storage requests only: /storage/<bucket>/<key> with a SigV4
	# signature in the query string. Anything else (bucket listing, unsigned or
	# other-method requests) is refused here, before it reaches the store. The
	# prefix is stripped; the Host header is kept, as the signature covers it.
	@presigned {
		method GET HEAD PUT
		path_regexp ^/storage/[^/]+/.+
		query X-Amz-Signature=*
	}
	handle @presigned {
		request_body {
			max_size 30MB
		}
		uri strip_prefix /storage
		reverse_proxy storage:9000
	}
	handle /storage/* {
		respond "Forbidden" 403
	}

	handle {
		reverse_proxy web:3000
	}
}

# Container health check only; not published outside the container.
:8081 {
	respond /health "ok" 200
}
