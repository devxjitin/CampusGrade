# Auto detect text files and perform LF normalization
* text=auto

# Files that run inside Linux containers must keep LF endings even when
# checked out on Windows (a CRLF shebang line breaks the script).
*.sh text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
