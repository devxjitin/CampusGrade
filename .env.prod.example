# Non-secret production settings. Copy to .env.prod (git-ignored) and edit.
# Secrets are NOT set here: they live in ./secrets/*.txt (see scripts\init-secrets.ps1).

# Public address the proxy serves. "campusgrade.localhost" resolves to this PC
# in modern browsers. For a LAN hostname or real domain, set it here and point
# ALLOWED_ORIGINS / PRIVATE_S3_PUBLIC_ENDPOINT at the same host.
SITE_ADDRESS=campusgrade.localhost
ALLOWED_ORIGINS=https://campusgrade.localhost
PRIVATE_S3_PUBLIC_ENDPOINT=https://campusgrade.localhost/storage

# "internal" = Caddy's own local CA (browsers must trust it once; see README).
# For a real, internet-reachable domain use a contact email to get a
# Let's Encrypt certificate instead, e.g. CADDY_TLS=admin@your-college.edu
CADDY_TLS=internal

# Image source and version (scripts\deploy.ps1 -Version sets CAMPUSGRADE_VERSION).
CAMPUSGRADE_REGISTRY=ghcr.io/devxjitin
# CAMPUSGRADE_VERSION=v0.1.0
# Use "never" only when testing locally built images.
# CAMPUSGRADE_PULL_POLICY=always

# Public URL used in email links (no trailing slash). Defaults to https://campusgrade.localhost.
APP_BASE_URL=https://campusgrade.localhost

# Email (password reset and notifications). Leave SMTP_HOST empty to disable sending; the
# worker then only logs. The password is a secret: put it in secrets/smtp_password.txt, not here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=CampusGrade <no-reply@your-college.edu>
SMTP_STARTTLS=true

# Tuning
WEB_CONCURRENCY=2
REPOSITORY_SYNC_INTERVAL_SECONDS=120

# Backups: nightly database dump + file copy, kept 14 daily / 8 weekly. Point this at
# a folder outside Docker's disk (another drive is best), e.g. D:/CampusGradeBackups.
# scriptsestore.ps1 -From <folder inside it> restores one.
BACKUP_DIR=./backups
BACKUP_HOUR=2
